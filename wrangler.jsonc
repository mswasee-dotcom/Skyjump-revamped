// Cloudflare Workers static-assets deployment (no server code; just serves dist/).
// Deploy: npm run deploy  ->  https://neon-roadrunner.<your-subdomain>.workers.dev
{
  "name": "neon-roadrunner",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
